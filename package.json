{
  "name": "dotpi",
  "version": "0.1.0",
  "type": "module",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": ["./skills"]
  },
  "scripts": {
    "build": "tsc",
    "format": "prettier --write src",
